  "micro_physical_hints": [
    "望向 6 米（20 英尺）以外的物体。",
    "缓慢眨眼 10 次。",
    "向后转动肩膀，再向前转动。",
    "向左右两侧拉伸颈部。",
    "喝一小口水。",
    "活动一下手指和脚趾。",
    "视线依次看向上下左右。",
    "双手合十，拉伸双腕。",
    "双臂向上伸展，缓慢拉向天花板。",
    "站起来，抖抖双手。",
    "在椅子上轻柔地左右转体。",
    "张开并握紧拳头 10 次。",
    "望向最近的窗外。",
    "缓慢转动脚踝画圈。",
    "将肩胛骨向后收紧，保持 5 秒。",
    "头部向两侧倾斜，感受颈部拉伸。",
    "站起身，向下弯腰，轻触脚尖。",
    "用鼻尖在空中画几个字母。"
  ],
  "micro_psychological_hints": [
    "放松紧绷的下颌。",
    "做 5 次缓慢的深呼吸。",
    "放柔视线，放松面部表情。",
    "靠向椅背，沉下双肩。",
    "注意此刻你能听到的三样声音。",
    "在心中默想一件今天进展顺利的事。",
    "让舌头自然搭在上门牙后方。",
    "感受身体沉在椅子上的重量。",
    "微笑一下，哪怕只是浅浅一笑。",
    "吸一口气，以两倍的慢节奏缓缓呼出。",
    "稍作停顿，感知身体此刻的需求。",
    "犒劳自己：感谢自己到目前为止的付出。"
  ],
  "long_hints": [
    "站起身，望向窗外，做做拉伸。",
    "走动走动 —— 哪怕一分钟也很有帮助。",
    "离开屏幕，泡一杯热茶或咖啡。",
    "做几个全身舒展动作。",
    "走到另一个房间再走回来。",
    "拉伸背部、肩膀和双腿。",
    "呼吸一下新鲜空气。",
    "去把水杯装满水。",
    "快速扫描全身 —— 哪里的肌肉在紧绷？",
    "尝试进行一分钟缓慢的深呼吸。",
    "转动活动手腕、脚踝和颈部。",
    "挺拔站立，双臂高举过头顶拉伸。",
    "走到室外沐浴几分钟自然日光。",
    "享用一份健康点心 —— 水果、坚果或奶酪。",
    "在平地上躺平一分钟，让重力帮你重置身心。",
    "放一首你喜欢的音乐，静心倾听。",
    "整理一下身边的一小块桌面或空间。",
    "去任何地方时，特意多绕几步路。",
    "用清凉的水洗把脸。",
    "离开工位，抬头看一分钟天空。"
  ],
  "long_social_hints": [
    "给你在乎的人打个电话。",
    "给朋友发条信息打个招呼。",
    "和同事一起去外面走走。",
    "走到同事桌前聊上两句。",
    "和某人一起去冲杯咖啡。",
    "如果可以，结伴去室外坐坐。",
    "问问队友今天过得怎么样。",
    "给某人写一张简短的感谢便签。",
    "和他人一起享用点心，而不是留在工位。",
    "和身边的人分享一件有趣的小事。",
    "联系一位许久未曾联络的朋友。",
    "和朋友或伴侣一起散散步。",
    "给朋友发一条语音消息代替打字。",
    "由衷地赞美某人一句。",
    "邀请他人和你一起进行下一次休息。"
  ],
  "sleep_hints": [
    "是时候放松收尾了。",
    "今晚就到这里，离开屏幕吧。",
    "好好睡一觉 —— 未完的工作明天依然会在。",
    "调暗灯光，合上笔记本，好好休息。",
    "阅读或拉伸远比继续看屏幕更放松。",
    "善待明天的自己，去休息吧。",
    "明天的专注力始于今晚的高质量睡眠。",
    "放下工作，你已经值得好好休息。",
    "泡杯舒缓的花草茶，不要再开启新任务了。",
    "备好明天的日程，合上今晚的笔记。",
    "记下明天要做的第一件事 —— 然后就此停下。",
    "慢节奏拉伸 5 分钟，然后准备就寝。"
